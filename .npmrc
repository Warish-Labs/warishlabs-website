legacy-peer-deps=true

# Explicitly approve postinstall scripts for packages that require them.
# These were previously generating "npm warn allow-scripts" noise on every CI run,
# hiding real problems. Approving here is deliberate — these are trusted packages.
allow-scripts=@clerk/shared@true,@prisma/engines@true,@sentry/cli@true,prisma@true,unrs-resolver@true

