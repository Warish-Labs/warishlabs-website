# WarishLabs Environment Variables Template

# 1. Database (PostgreSQL)
# Local Dev Example: postgresql://postgres:Warish@786@localhost:5432/warishlabs?schema=public
# Production Example (Neon): postgresql://[user]:[password]@[neon-hostname]/neondb?sslmode=require
DATABASE_URL="postgresql://postgres:Warish@786@localhost:5432/warishlabs?schema=public"

ADMIN_EMAIL="warishlabs@gmail.com"

# 2. Analytics Database (Separate Neon Project)
# Pooled connection string for app runtime queries
ANALYTICS_DATABASE_URL="postgresql://user:pass@ep-analytics-pooler.neon.tech/analytics?sslmode=require"
# Direct non-pooled connection string for Prisma migrations
ANALYTICS_DIRECT_URL="postgresql://user:pass@ep-analytics.neon.tech/analytics?sslmode=require"

# 3. Alerting & Notifications
ALERT_EMAIL_RECIPIENTS="warishdeveloper@gmail.com,warishlabs@gmail.com"

# 4. Media Service (Cloudinary)
CLOUDINARY_CLOUD_NAME="your_cloud_name"
CLOUDINARY_API_KEY="your_api_key"
CLOUDINARY_API_SECRET="your_api_secret"

# 5. Email Service (Resend)
RESEND_API_KEY="re_your_resend_api_key"

# 6. Security & System
# Token used to secure the daily CRON cleanup endpoint
CRON_SECRET="your_secure_random_cron_secret"

# 7. Rate Limiting (Upstash Redis - optional for development fallback)
UPSTASH_REDIS_REST_URL="https://your-redis-instance.upstash.io"
UPSTASH_REDIS_REST_TOKEN="your_upstash_redis_token"

# 8. Business & Company Configuration (For Legal Pages & Site Metadata)
NEXT_PUBLIC_COMPANY_NAME="WarishLabs"
NEXT_PUBLIC_CONTACT_EMAIL="contact@warishlabs.in"
NEXT_PUBLIC_SUPPORT_EMAIL="contact@warishlabs.in"
NEXT_PUBLIC_CANONICAL_URL="warishlabs.in"

